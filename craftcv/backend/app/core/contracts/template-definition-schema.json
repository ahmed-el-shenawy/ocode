{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "template-definition-schema.json",
  "title": "Template Definition",
  "description": "Schema for CraftCV resume template definitions (stored in templates.definition JSONB column)",
  "type": "object",
  "required": ["sections", "layout"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/SectionDefinition"
      }
    },
    "layout": {
      "$ref": "#/definitions/LayoutDefinition"
    }
  },
  "definitions": {
    "SectionDefinition": {
      "type": "object",
      "required": ["id", "type", "label", "fields"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "enum": ["header", "summary", "experience", "education", "projects", "skills", "certifications", "languages", "custom"]
        },
        "label": {
          "type": "string",
          "maxLength": 255
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "min_items": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/FieldDefinition"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "header" } }
          },
          "then": {
            "properties": {
              "required": { "const": true },
              "max_items": { "const": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "custom" } }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["text", "richtext", "url"]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "FieldDefinition": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "url", "date", "boolean", "richtext", "list", "tags", "select"]
        },
        "label": {
          "type": "string",
          "maxLength": 255
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "max_length": {
          "type": "integer",
          "minimum": 1
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["text", "richtext"] } }
          },
          "then": {
            "properties": {
              "max_length": { "type": "integer" }
            }
          },
          "else": {
            "properties": {
              "max_length": { "not": {} }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["list", "tags"] } }
          },
          "then": {
            "properties": {
              "min": { "type": "integer" },
              "max": { "type": "integer" }
            }
          },
          "else": {
            "properties": {
              "min": { "not": {} },
              "max": { "not": {} }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "select" } }
          },
          "then": {
            "required": ["options"]
          },
          "else": {
            "properties": {
              "options": { "not": {} }
            }
          }
        }
      ]
    },
    "LayoutDefinition": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 1
        },
        "color_scheme": {
          "type": "object",
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "secondary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        },
        "fonts": {
          "type": "object",
          "properties": {
            "heading": { "type": "string" },
            "body": { "type": "string" }
          }
        }
      }
    }
  }
}
