# Supabase Connection
SUPABASE_URL=                 # Your Supabase project URL (e.g. https://xyz.supabase.co)
SUPABASE_SERVICE_KEY=         # Supabase service_role key (server-side, admin access)
SUPABASE_ANON_KEY=            # Supabase anon/public key (client-side, RLS enforced)
SUPABASE_JWT_SECRET=          # JWT secret used by Supabase for token verification

# Database
DATABASE_URL=                 # PostgreSQL connection string (postgresql+asyncpg://user:pass@host:5432/db)

# JWT
JWT_SECRET=                   # Secret key for signing application JWTs

# AI Providers
OPENAI_API_KEY=               # OpenAI API key (GPT-4o)
ANTHROPIC_API_KEY=            # Anthropic API key (Claude Sonnet)
GEMINI_API_KEY=               # Google AI API key (Gemini Pro)
GROQ_API_KEY=

# Infrastructure
REDIS_URL=                    # Redis connection string for Celery task queue
STORAGE_BUCKET=               # Supabase storage bucket name for resume uploads
PDF_STORAGE_PATH=             # Local path or S3 bucket for generated PDF files
